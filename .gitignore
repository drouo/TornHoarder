__pycache__/
*.pyc
*.pyo

# Runtime/server state, not source
tools/.tma_server.json
tools/.tma_server.log
tools/.tma_server.err.log
tools/.update_server.log
tools/.update_server.err.log

# Local user config (API key)
.tma_config.json

# Generated by the app at runtime (regenerated each run)
data/tornhoarder.user.js

# What each city shop was seen buying during shop runs (per-player)
data/shop_buys.json
data/tma_autofill.user.js

# Organized-crime required items, cached from torn/organizedcrimes
data/oc_items.json

# Your weapon/armor copies' stats, cached by uid (they never change)
data/uid_stats.json

# One row per priced item per run
data/price_history.csv
